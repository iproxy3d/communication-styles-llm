+<path d="M1200 310 L1235 310" class="line"/>
+<rect x="120" y="570" width="1510" height="270" rx="20" class="card"/>
+<text x="875" y="615" text-anchor="middle" class="t b">4. ОБУЧЕНИЕ И ЗАТУХАНИЕ</text>
+<text x="185" y="680" text-anchor="start" class="t s">Новый опыт обновляет связь плавно:</text>
+<text x="185" y="725" text-anchor="start" class="t b">Aₜ₊₁(x) = Aₜ(x) + η(Eₜ − Aₜ(x))</text>
