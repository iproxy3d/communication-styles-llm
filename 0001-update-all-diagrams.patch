+<svg xmlns="http://www.w3.org/2000/svg" width="1800" height="1000" viewBox="0 0 1800 1000">
+<defs><style>
+.t{font-family:Arial,sans-serif;fill:#17233b}.h{font-size:38px;font-weight:800}.b{font-size:24px;font-weight:750}.s{font-size:19px}.c{font-size:16px;fill:#617087}.tiny{font-size:14px}.card{fill:#fff;stroke:#d7dfeb;stroke-width:2}.blue{fill:#edf4ff;stroke:#557fbb}.pink{fill:#fff0f4;stroke:#cf688b}.green{fill:#ecf8f2;stroke:#4c9c72}.orange{fill:#fff5df;stroke:#d99a3b}.purple{fill:#f3efff;stroke:#755bc2}.dash{stroke-dasharray:9 7}.line{fill:none;stroke:#5975bb;stroke-width:4;marker-end:url(#a)}
+</style><marker id="a" markerWidth="12" markerHeight="12" refX="10" refY="5" orient="auto"><path d="M0 0L10 5L0 10z" fill="#5975bb"/></marker></defs>
+<rect width="1800" height="1000" fill="#f8faff"/>
+<text x="900.0" y="58" text-anchor="middle" class="t h">КАК ФОРМИРУЕТСЯ АССОЦИАТИВНАЯ ПАМЯТЬ</text>
+<text x="900.0" y="94" text-anchor="middle" class="t c">Полный цикл: сущности → отдельные профили → агрегирование → использование → обновление</text>
+<rect x="30" y="140" width="325" height="155" rx="20" class="card"/>
+<text x="192" y="185" text-anchor="middle" class="t b">1. Xₜ</text>
+<text x="192" y="240" text-anchor="middle" class="t c">«Встретил Ивана в аэропорту»</text>
+<path d="M360 215 L380 215" class="line"/>
+<rect x="385" y="140" width="325" height="155" rx="20" class="card"/>
+<text x="547" y="185" text-anchor="middle" class="t b">2. ENTITY EXTRACTION</text>
+<text x="547" y="240" text-anchor="middle" class="t c">q₁ = Иван · q₂ = аэропорт</text>
+<path d="M715 215 L735 215" class="line"/>
+<rect x="740" y="140" width="325" height="155" rx="20" class="card"/>
+<text x="902" y="185" text-anchor="middle" class="t b">3. LOOKUP</text>
+<text x="902" y="240" text-anchor="middle" class="t c">qᵢ → A(qᵢ)</text>
+<path d="M1070 215 L1090 215" class="line"/>
+<rect x="1095" y="140" width="325" height="155" rx="20" class="card"/>
+<text x="1257" y="185" text-anchor="middle" class="t b">4. AGGREGATE</text>
+<text x="1257" y="240" text-anchor="middle" class="t c">Aₜ = F(A(q₁), A(q₂))</text>
+<path d="M1425 215 L1445 215" class="line"/>
+<rect x="1450" y="140" width="325" height="155" rx="20" class="card"/>
+<text x="1612" y="185" text-anchor="middle" class="t b">5. USE</text>
+<text x="1612" y="240" text-anchor="middle" class="t c">Sₜ → policy → selector</text>
+<rect x="170" y="390" width="1460" height="210" rx="20" class="purple"/>
+<text x="900" y="435" text-anchor="middle" class="t b">ХРАНИЛИЩЕ A(x)</text>
+<text x="230" y="495" text-anchor="start" class="t s">Иван: anger 0.4 · annoyance 0.5 · sadness 0.1</text>
+<text x="230" y="545" text-anchor="start" class="t s">аэропорт: fear 0.3 · neutral 0.6</text>
+<text x="980" y="495" text-anchor="start" class="t s">Новая сущность: начальный нейтральный или авторский профиль</text>
+<text x="980" y="545" text-anchor="start" class="t s">Несколько сущностей не превращаются автоматически в одно воспоминание</text>
+<rect x="170" y="680" width="650" height="210" rx="20" class="orange"/>
+<text x="495" y="725" text-anchor="middle" class="t b">ОБНОВЛЕНИЕ ПОСЛЕ ДИАЛОГА</text>
+<text x="220" y="785" text-anchor="start" class="t s">Aₜ₊₁(x) = Aₜ(x) + η(Eₜ − Aₜ(x))</text>
+<text x="220" y="835" text-anchor="start" class="t c">контекст, важность и уверенность могут менять η</text>
+<rect x="980" y="680" width="650" height="210" rx="20" class="blue"/>
+<text x="1305" y="725" text-anchor="middle" class="t b">ЗАТУХАНИЕ</text>
+<text x="1040" y="785" text-anchor="start" class="t b">A ← γA</text>
+<text x="1040" y="835" text-anchor="start" class="t s">γ ≈ 1: медленно · меньшее γ: быстрее</text>
+<path d="M900 615 L900 670" class="line"/>
+</svg>
